{
  "name": "vela",
  "version": "0.1.33",
  "description": "mpv-backed HDR media client (Plex, Jellyfin, Emby, local)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:arch": "npm run tauri -- build --no-bundle && cd packaging/arch && makepkg -f",
    "build:linux": "tauri build --bundles deb,rpm",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "e2e": "node tests/e2e/run.mjs",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
