# Build environment for the libmpv set Vela ships: the oldest distribution
# Vela's own Linux bundles are built on (Ubuntu 22.04, glibc 2.35).
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential pkg-config nasm ninja-build cmake \
      python3 python3-pip python3-jinja2 python3-markupsafe \
      curl ca-certificates xz-utils file patch \
      libegl-dev libgl-dev libdrm-dev libva-dev libpulse-dev libasound2-dev \
      libfontconfig-dev libgnutls28-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/* \
 && pip3 install --no-cache-dir meson==1.6.1 patchelf==0.17.2.1
