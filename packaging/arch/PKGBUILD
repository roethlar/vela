# Maintainer: Michael Coelho
pkgname=vela
pkgver=0.1.44
pkgrel=1
pkgdesc='mpv-backed HDR media client for Plex, Jellyfin, and Emby'
arch=('x86_64')
license=('MIT' 'GPL2')
# Vela's release profile already strips the binary, so the makepkg debug split
# finds no symbols — skip it (no empty -debug package, no gdb-add-index warning).
options=('!debug')
depends=('webkit2gtk-4.1' 'libsoup3' 'mpv' 'hicolor-icon-theme')
source=()
sha256sums=()

package() {
  local repo
  repo="$(realpath "$startdir/../..")"

  install -Dm755 "$repo/src-tauri/target/release/vela" "$pkgdir/usr/bin/vela"
  install -Dm644 "$repo/packaging/arch/vela.desktop" "$pkgdir/usr/share/applications/Vela.desktop"

  install -Dm644 "$repo/src-tauri/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/vela.png"
  install -Dm644 "$repo/src-tauri/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/vela.png"
  install -Dm644 "$repo/src-tauri/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256@2/apps/vela.png"
  install -Dm644 "$repo/src-tauri/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/vela.png"

  install -Dm644 "$repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Bundled mpv autocrop script (GPLv2+, unmodified). Installed at the path the
  # app resolves at runtime: Tauri BaseDirectory::Resource maps to
  # /usr/lib/<productName>/ for a /usr/bin/vela binary, i.e. /usr/lib/Vela/ — the
  # same layout the deb/rpm bundles use. build:arch runs `tauri build --no-bundle`,
  # so Tauri does not stage resources itself; install them explicitly here.
  install -Dm644 "$repo/src-tauri/resources/mpv-scripts/autocrop.lua" "$pkgdir/usr/lib/Vela/mpv-scripts/autocrop.lua"
  # Vela's own trigger shim (repo license, not upstream): auto mode loads the
  # stock script with its trigger disabled and this shim fires detection after
  # a settle delay — without it, resumed plays fall back to the broken stock
  # trigger (see the shim header).
  install -Dm644 "$repo/src-tauri/resources/mpv-scripts/vela-autocrop.lua" "$pkgdir/usr/lib/Vela/mpv-scripts/vela-autocrop.lua"
  install -Dm644 "$repo/src-tauri/resources/mpv-scripts/LICENSE.GPL" "$pkgdir/usr/lib/Vela/mpv-scripts/LICENSE.GPL"
  install -Dm644 "$repo/src-tauri/resources/mpv-scripts/PROVENANCE.md" "$pkgdir/usr/lib/Vela/mpv-scripts/PROVENANCE.md"
  # GPL license text for the bundled script (Arch license convention).
  install -Dm644 "$repo/src-tauri/resources/mpv-scripts/LICENSE.GPL" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.GPL"
}
